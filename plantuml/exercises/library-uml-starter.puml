@startuml
skinparam dpi 150
skinparam classAttributeIconSize 0
hide empty members

abstract class Item {
  - title : String
  - catalogueNumber : String
  + getTitle() : String
  + getCatalogueNumber() : String
}

interface Borrowable {
  + getLoanPeriodDays() : int
  + isOnLoan() : boolean
  + borrow(member : Member) : void
  + returnItem() : void
  + placeHold(member : Member) : Hold
}

abstract class LoanableItem {
  - loanPeriodDays : int
  - borrower : Member
  - holds : List<Hold>
  + getLoanPeriodDays() : int
  + isOnLoan() : boolean
  + borrow(member : Member) : void
  + returnItem() : void
  + placeHold(member : Member) : Hold
}

class Book
class DVD
class ReferenceItem

note right of Book : loanPeriodDays = 21
note right of DVD : loanPeriodDays = 7
note right of ReferenceItem : Does not implement Borrowable.

class Member {
  - memberNumber : String
  - lateFee : double
  + login(memberNumber : String) : boolean
  + borrow(item : Borrowable) : void
  + placeHold(item : Borrowable) : Hold
  + waiveLateFee() : void
}

class Librarian {
  + addItem(catalogue : Catalogue, item : Item) : void
  + waiveLateFee(member : Member) : void
}

class Catalogue {
  - items : Map<String, Item>
  + addItem(item : Item) : void
  + findItem(catalogueNumber : String) : Item
}

class Hold {
  - member : Member
  - item : LoanableItem
  + getMember() : Member
  + getItem() : LoanableItem
}

Item <|-- LoanableItem
Item <|-- ReferenceItem
LoanableItem <|-- Book
LoanableItem <|-- DVD
Borrowable <|.. LoanableItem
Catalogue "1" o-- "0..*" Item : indexes unique catalogue numbers
LoanableItem "0..*" --> "0..1" Member : borrower
LoanableItem "1" *-- "0..*" Hold : ordered holds
Hold "0..*" --> "1" Member : requester
Member ..> Borrowable : borrows / places holds
Librarian ..> Catalogue : adds items
Librarian ..> Member : waives late fees
@enduml
